                <calaos:param name="put_back_delay_max" value="60"/>
                <calaos:param name="humidity_max" value="60"/>
            </calaos:device>
            <calaos:output host="192.168.1.20" id="plancher_chaud" io_style="light" name="Plancher chaud" port="502" type="WODigital" var="5"/>
            <calaos:output host="192.168.1.20" id="plancher_froid" io_style="light" name="Plancher froid" port="502" type="WODigital" var="6"/>
