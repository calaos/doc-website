                <calaos:param name="hysteresis" value="0.5"/>
                <calaos:param name="min_on_time" value="600"/>
                <calaos:param name="min_off_time" value="300"/>
                <calaos:param name="min_range" value="2"/>
                <calaos:param name="sensor_timeout" value="9000"/>
                <calaos:param name="put_back_delay" value="1"/>
                <calaos:param name="put_back_delay_max" value="60"/>
            </calaos:device>
            <calaos:output host="192.168.1.20" id="cuisine_pac_chaud" io_style="light" name="PAC cuisine chaud" port="502" type="WODigital" var="2"/>
            <calaos:output host="192.168.1.20" id="cuisine_pac_froid" io_style="light" name="PAC cuisine froid" port="502" type="WODigital" var="3"/>
        </calaos:room>
