                <calaos:internal id="pac_cuisine_target_temp_high" name="PAC cuisine consigne haute" save="true" step="0.5" type="InternalInt" unit="°C" value="25" value_max="30" value_min="7" visible="false"/>
                <calaos:internal id="pac_cuisine_action" name="PAC cuisine action" type="InternalString" visible="false"/>
                <calaos:link name="current_temp" io="cuisine_temp"/>
                <calaos:link name="target_temp" io="pac_cuisine_target_temp"/>
                <calaos:link name="target_temp_low" io="pac_cuisine_target_temp_low"/>
                <calaos:link name="target_temp_high" io="pac_cuisine_target_temp_high"/>
                <calaos:link name="action" io="pac_cuisine_action"/>
