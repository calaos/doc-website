                <calaos:link name="target_temp" io="plancher_sejour_target_temp"/>
                <calaos:link name="target_temp_low" io="plancher_sejour_target_temp_low"/>
                <calaos:link name="target_temp_high" io="plancher_sejour_target_temp_high"/>
                <calaos:link name="action" io="plancher_sejour_action"/>
                <calaos:link name="output_heat" io="plancher_chaud"/>
                <calaos:link name="output_cool" io="plancher_froid"/>
                <calaos:link name="humidity" io="sejour_hum"/>
