<?xml version="1.0" encoding="UTF-8"?>
<calaos:ioconfig xmlns:calaos="http://www.calaos.fr">
    <calaos:home format="2">
        <calaos:room name="Salon" type="salon" hits="0">
            <calaos:input host="127.0.0.1" id="salon_temp" name="Température salon" path="temperature" port="1883" topic_sub="maison/salon/temperature" type="MqttInputTemp" unit="°C"/>
            <calaos:input host="127.0.0.1" id="salon_hum" name="Humidité salon" path="humidity" port="1883" topic_sub="maison/salon/humidite" type="MqttInputAnalog" unit="%"/>
            <calaos:device id="clim_salon" impl="proxy" name="Clim salon" type="climate">
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" data="__##VALUE##__" host="127.0.0.1" id="clim_salon_mode" name="Clim salon mode" port="1883" topic_pub="clim_salon/climate/clim_salon/mode/command" topic_sub="clim_salon/climate/clim_salon/mode/state" type="MqttOutputString" visible="false"/>
                <calaos:input connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" host="127.0.0.1" id="clim_salon_current_temp" name="Clim salon température" port="1883" topic_sub="clim_salon/climate/clim_salon/current_temperature/state" type="MqttInputTemp" visible="false"/>
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" data="__##VALUE##__" host="127.0.0.1" id="clim_salon_target_temp_low" name="Clim salon consigne basse" port="1883" step="0.5" topic_pub="clim_salon/climate/clim_salon/target_temperature_low/command" topic_sub="clim_salon/climate/clim_salon/target_temperature_low/state" type="MqttOutputAnalog" unit="°C" value_max="28" value_min="17" visible="false"/>
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" data="__##VALUE##__" host="127.0.0.1" id="clim_salon_target_temp_high" name="Clim salon consigne haute" port="1883" step="0.5" topic_pub="clim_salon/climate/clim_salon/target_temperature_high/command" topic_sub="clim_salon/climate/clim_salon/target_temperature_high/state" type="MqttOutputAnalog" unit="°C" value_max="28" value_min="17" visible="false"/>
                <calaos:input connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" host="127.0.0.1" id="clim_salon_action" name="Clim salon action" port="1883" topic_sub="clim_salon/climate/clim_salon/action/state" type="MqttInputString" visible="false"/>
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" data="__##VALUE##__" host="127.0.0.1" id="clim_salon_fan_mode" name="Clim salon ventilation" port="1883" topic_pub="clim_salon/climate/clim_salon/fan_mode/command" topic_sub="clim_salon/climate/clim_salon/fan_mode/state" type="MqttOutputString" visible="false"/>
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" data="__##VALUE##__" host="127.0.0.1" id="clim_salon_swing_mode" name="Clim salon oscillation" port="1883" topic_pub="clim_salon/climate/clim_salon/swing_mode/command" topic_sub="clim_salon/climate/clim_salon/swing_mode/state" type="MqttOutputString" visible="false"/>
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" data="__##VALUE##__" host="127.0.0.1" id="clim_salon_remote_temp" name="Clim salon température distante" port="1883" topic_pub="clim_salon/calaos/remote_temp" topic_sub="clim_salon/calaos/remote_temp" type="MqttOutputAnalog" visible="false"/>
                <calaos:link name="mode" io="clim_salon_mode"/>
                <calaos:link name="current_temp" io="clim_salon_current_temp"/>
                <calaos:link name="target_temp_low" io="clim_salon_target_temp_low"/>
                <calaos:link name="target_temp_high" io="clim_salon_target_temp_high"/>
                <calaos:link name="action" io="clim_salon_action"/>
                <calaos:link name="fan_mode" io="clim_salon_fan_mode"/>
                <calaos:link name="swing_mode" io="clim_salon_swing_mode"/>
                <calaos:link name="remote_temp" io="clim_salon_remote_temp"/>
                <calaos:link name="remote_temp_source" io="salon_temp"/>
                <calaos:param name="modes" value="off,heat,cool,auto,dry,fan_only"/>
                <calaos:param name="auto_payload" value="heat_cool"/>
                <calaos:param name="fan_modes" value="auto,low,medium,high,quiet"/>
                <calaos:param name="swing_modes" value="off,both,vertical,horizontal"/>
                <calaos:param name="remote_temp_keepalive" value="120"/>
                <calaos:param name="sensor_timeout" value="9000"/>
            </calaos:device>
        </calaos:room>
        <calaos:room name="Chambre" type="chambre" hits="0">
            <calaos:device id="clim_chambre" impl="proxy" name="Clim chambre" type="climate">
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_chambre/status" data="__##VALUE##__" host="127.0.0.1" id="clim_chambre_mode" name="Clim chambre mode" port="1883" topic_pub="clim_chambre/climate/clim_chambre/mode/command" topic_sub="clim_chambre/climate/clim_chambre/mode/state" type="MqttOutputString" visible="false"/>
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_chambre/status" data="__##VALUE##__" host="127.0.0.1" id="clim_chambre_target_temp" name="Clim chambre consigne" port="1883" step="1" topic_pub="clim_chambre/climate/clim_chambre/target_temperature/command" topic_sub="clim_chambre/climate/clim_chambre/target_temperature/state" type="MqttOutputAnalog" unit="°C" value_max="30" value_min="16" visible="false"/>
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_chambre/status" data="__##VALUE##__" host="127.0.0.1" id="clim_chambre_fan_mode" name="Clim chambre ventilation" port="1883" topic_pub="clim_chambre/climate/clim_chambre/fan_mode/command" topic_sub="clim_chambre/climate/clim_chambre/fan_mode/state" type="MqttOutputString" visible="false"/>
                <calaos:link name="mode" io="clim_chambre_mode"/>
                <calaos:link name="target_temp" io="clim_chambre_target_temp"/>
                <calaos:link name="fan_mode" io="clim_chambre_fan_mode"/>
                <calaos:param name="modes" value="off,heat,cool,auto"/>
                <calaos:param name="auto_payload" value="heat_cool"/>
                <calaos:param name="fan_modes" value="auto,low,medium,high"/>
            </calaos:device>
        </calaos:room>
        <calaos:room name="Bureau" type="bureau" hits="0">
            <calaos:input host="127.0.0.1" id="bureau_temp" name="Température bureau" path="temperature" port="1883" topic_sub="maison/bureau/temperature" type="MqttInputTemp" unit="°C"/>
            <calaos:input host="192.168.1.20" id="bureau_fenetre" name="Fenêtre bureau" port="502" type="WIDigitalBP" var="4"/>
            <calaos:device id="radiateur_bureau" impl="thermostat" name="Radiateur bureau" type="climate">
                <calaos:internal id="radiateur_bureau_target_temp" name="Radiateur bureau consigne" save="true" step="0.5" type="InternalInt" unit="°C" value="20" value_max="30" value_min="7" visible="false"/>
                <calaos:internal id="radiateur_bureau_action" name="Radiateur bureau action" type="InternalString" visible="false"/>
                <calaos:link name="current_temp" io="bureau_temp"/>
                <calaos:link name="target_temp" io="radiateur_bureau_target_temp"/>
                <calaos:link name="action" io="radiateur_bureau_action"/>
                <calaos:link name="output_heat" io="bureau_radiateur"/>
                <calaos:param name="emitter" value="electric"/>
                <calaos:param name="hysteresis" value="0.3"/>
                <calaos:param name="min_on_time" value="120"/>
                <calaos:param name="min_off_time" value="120"/>
                <calaos:param name="sensor_timeout" value="9000"/>
                <calaos:param name="put_back_delay" value="1"/>
                <calaos:param name="put_back_delay_max" value="60"/>
            </calaos:device>
            <calaos:output host="192.168.1.20" id="bureau_radiateur" io_style="light" name="Relais radiateur bureau" port="502" type="WODigital" var="1"/>
        </calaos:room>
        <calaos:room name="Cuisine" type="cuisine" hits="0">
            <calaos:input host="127.0.0.1" id="cuisine_temp" name="Température cuisine" path="temperature" port="1883" topic_sub="maison/cuisine/temperature" type="MqttInputTemp" unit="°C"/>
            <calaos:device id="pac_cuisine" impl="thermostat" name="PAC cuisine" type="climate">
                <calaos:internal id="pac_cuisine_target_temp" name="PAC cuisine consigne" save="true" step="0.5" type="InternalInt" unit="°C" value="20" value_max="30" value_min="7" visible="false"/>
