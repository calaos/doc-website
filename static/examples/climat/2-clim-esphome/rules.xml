<?xml version="1.0" encoding="UTF-8"?>
<calaos:rules xmlns:calaos="http://www.calaos.fr">
    <calaos:rule name="Absence : clim en veille large" type="Chauffage">
        <calaos:condition type="standard" trigger="true">
            <calaos:input id="absence" oper="==" val="true"/>
        </calaos:condition>
        <calaos:action type="standard">
            <calaos:output id="clim_salon" val="{&quot;mode&quot;:&quot;auto&quot;,&quot;target_temp_low&quot;:16,&quot;target_temp_high&quot;:28}"/>
        </calaos:action>
    </calaos:rule>
    <calaos:rule name="Retour : clim au confort" type="Chauffage">
        <calaos:condition type="standard" trigger="true">
            <calaos:input id="absence" oper="==" val="false"/>
        </calaos:condition>
        <calaos:action type="standard">
            <calaos:output id="clim_salon" val="{&quot;mode&quot;:&quot;auto&quot;,&quot;target_temp_low&quot;:20,&quot;target_temp_high&quot;:25}"/>
        </calaos:action>
    </calaos:rule>
    <calaos:rule name="Hors-gel : nuit d'hiver" type="Chauffage">
        <calaos:condition type="standard" trigger="true">
            <calaos:input id="nuit" oper="==" val="true"/>
        </calaos:condition>
        <calaos:condition type="standard" trigger="true">
            <calaos:input id="salon_temp" oper="&lt;" val="10"/>
        </calaos:condition>
        <calaos:action type="standard">
            <calaos:output id="clim_salon" val="{&quot;mode&quot;:&quot;heat&quot;,&quot;target_temp&quot;:17}"/>
        </calaos:action>
    </calaos:rule>
</calaos:rules>
