<?xml version="1.0" encoding="UTF-8"?>
<calaos:ioconfig xmlns:calaos="http://www.calaos.fr">
    <calaos:home format="2">
        <calaos:room name="Salon" type="salon" hits="0">
            <calaos:internal id="salon_temp" name="Température salon (à remplacer)" type="InternalInt" unit="°C" value="20"/>
            <calaos:device id="clim_salon" impl="proxy" name="Clim salon" type="climate" visible="true">
                <calaos:output connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" data="__##VALUE##__" host="127.0.0.1" id="clim_salon_mode" name="Clim salon mode" port="1883" topic_pub="clim_salon/climate/clim_salon/mode/command" topic_sub="clim_salon/climate/clim_salon/mode/state" type="MqttOutputString" visible="false"/>
                <calaos:input connected_status_expr="value == 'online'" connected_status_topic="clim_salon/status" host="127.0.0.1" id="clim_salon_current_temp" name="Clim salon température" port="1883" topic_sub="clim_salon/climate/clim_salon/current_temperature/state" type="MqttInputTemp" visible="false"/>
